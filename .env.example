NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:888@localhost:5432/helpcrunch?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ISSUER="helpcrunch"
JWT_AUDIENCE="helpcrunch-api"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

SESSION_MAX_ACTIVE=10
CORS_ORIGIN="http://localhost:3000"

# Optional local/dev bootstrap. If set, `npm run prisma:seed:rbac` assigns ADMIN to this existing user.
# RBAC_BOOTSTRAP_ADMIN_EMAIL=test@example.com
