{
  "name": "helpcrunch-auth-core",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
  "build": "nest build",
  "start": "nest start",
  "start:dev": "nest start --watch",
  "start:debug": "nest start --debug --watch",
  "start:prod": "node dist/main",

  "lint": "eslint \"{src,test}/**/*.ts\" --fix",

  "test": "jest --config ./jest.config.cjs",
  "test:watch": "jest --watch",
  "test:cov": "jest --coverage",

  "test:e2e": "jest --config ./test/jest-e2e.json",

  "test:rbac": "jest --config ./test/jest-e2e.json --runInBand",

  "test:audit": "npm run test && npm run test:rbac",

  "verify": "npm run lint && npm run build && npm run test:audit",

  "prisma:generate": "prisma generate",
  "prisma:validate": "prisma validate",
  "prisma:format": "prisma format",
  "prisma:migrate:dev": "prisma migrate dev",
  "prisma:migrate:deploy": "prisma migrate deploy",

  "prisma:seed:rbac": "tsx prisma/seed-rbac.ts",
  "prisma:seed": "npm run prisma:seed:rbac",
  "rbac:seed": "npm run prisma:seed:rbac"
},
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed-rbac.ts"
  }
}
